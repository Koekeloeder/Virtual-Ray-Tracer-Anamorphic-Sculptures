  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The reflection rays of an object on a specular object (mirror) can be
    used to create distorted objects (sculptures). We need three things in to do
    this: a point of view (camera), a mirror (can have any shape), and the object
    we want to deform. A ray shoots from the camera to a point on the object. On
    its way to the object, the ray passes through the mirror. The intersection points
    of the ray with the mirror are calculated. The intersection point closest to
    the object is taken and the reflection ray at this point is determined. Next,
    we take the distance between the point on the object and the intersection point
    of the ray with the mirror. We call this distance D. The new \"distorted\" point
    will be displaced along the reflection ray at distance D from the intersection
    point. The process is repeated for all of the points of the object. \r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
